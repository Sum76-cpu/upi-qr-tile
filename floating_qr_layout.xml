<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for Floating UPI QR Overlay Window
    Clean card style with white background, rounded corners,
    drop shadow, instant QR visibility, and dismiss cues.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_overlay_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Centered Card Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_qr"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/tile_label"
                    android:src="@drawable/ic_upi_qr"
                    app:tint="#1E88E5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPI QR Payment"
                        android:textColor="#1A1A1A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto closes in 60s"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Brightness indicator badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_brightness_badge"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="100% Bright"
                    android:textColor="#E65100"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Thin Countdown Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_countdown"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginBottom="16dp"
                android:indeterminate="false"
                android:max="60"
                android:progress="60"
                android:progressBackgroundTint="#EEEEEE"
                android:progressTint="#1E88E5" />

            <!-- The QR Code Bitmap Container -->
            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:background="#F8F9FA"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/iv_qr_code"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="UPI QR Code"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_upi_qr" />

                <!-- Fallback error view if file is missing -->
                <LinearLayout
                    android:id="@+id/layout_error_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Image Not Found"
                        android:textColor="#D32F2F"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_error_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Place your image at:\n/storage/emulated/0/IMG_20260831_143523.jpg"
                        android:textColor="#616161"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Bottom helper text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawableStart="@android:drawable/ic_menu_close_clear_cancel"
                android:drawablePadding="6dp"
                android:drawableTint="#9E9E9E"
                android:text="Tap anywhere on card to dismiss"
                android:textColor="#757575"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>